# SandPod host MariaDB drop-in. Install (host, as root):
#   cp modules/host-mariadb/config/sandpod.cnf /etc/my.cnf.d/sandpod.cnf
#   systemctl restart mariadb
#
# Containers reach the host via the pasta gateway (NOT 127.0.0.1, which is
# the container's own netns). Find yours with:
#   podman exec customer-001 getent hosts host.containers.internal
# then open the firewall for that subnet ONLY (never 0.0.0.0/0 for 3306)
# and create users (sandpodctl create-site-db makes 'user'@'%' — tighten to the
# pasta subnet once it is pinned in your environment).
[mariadbd]
# utf8mb4 everywhere (matches CREATE DATABASE in sandpodctl create-site-db)
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
# Loopback + pasta gateway. Add the gateway IP found above, e.g.:
# bind-address = 127.0.0.1,::1,10.0.2.2
bind-address = 127.0.0.1,::1
# HMAC-sha256 auth noise reduction for many short-lived app connections
max_connections = 200
