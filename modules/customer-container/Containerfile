FROM quay.io/almalinuxorg/almalinux:10

RUN dnf -y install dnf-plugins-core epel-release \
    && dnf config-manager --set-enabled crb \
    && dnf -y install \
        capstone \
        cronie \
        gcc \
        gcc-c++ \
        git \
        htop \
        iotop-c \
        iproute \
        jq \
        make \
        mariadb \
        ncdu \
        net-tools \
        libatomic \
        libxslt \
        nginx \
        # NOTE: AlmaLinux 10 has no `nodejs22` package: `nodejs` tracks
        # Node 22.x and IS the node-22 fallback (`dnf list`: nodejs-1:22.x).
        nodejs \
        nodejs-npm \
        nodejs24 \
        nodejs24-npm \
        nodejs26 \
        nodejs26-npm \
        openssh-server \
        pkgconf-pkg-config \
        procps-ng \
        # NOTE: AlmaLinux 10 has no `python3.12` interpreter package:
        # `python3` is Python 3.12 and IS the python3.12 fallback.
        python3 \
        python3.13 \
        python3.14 \
        rsync \
        supervisor \
        sysstat \
        tar \
        unzip \
        wget \
        curl \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN useradd --create-home --shell /bin/bash customer \
    && password="$(openssl rand -base64 48)" \
    && usermod --password "$(openssl passwd -6 "$password")" customer \
    && unset password \
    && install -d -o customer -g customer -m 0700 /home/customer/.ssh \
    && touch /home/customer/.ssh/authorized_keys \
    && chown customer:customer /home/customer/.ssh/authorized_keys \
    && chmod 0600 /home/customer/.ssh/authorized_keys \
    && install -d -m 0755 \
        /run/sshd \
        /etc/sandpod-config \
        /etc/sandpod-config/sites \
        /etc/sandpod-config/supervisor \
        /etc/sandpod/php-fpm \
        /etc/opt/remi \
        /opt/remi \
        /opt/sandpod/node \
        /opt/sandpod/python \
        /srv/customer/public_html \
        /usr/lib64 \
    # Placeholder overlaid by the host read-only mount of the real libonig
    # (Remi PHP dependency). Without the mount the file is empty and Remi
    # php-fpm fails fast; use scripts/check-runtime-mounts for the
    # preflight check before shipping a rebuilt image.
    && install -m 0644 /dev/null /usr/lib64/libonig.so.105 \
    && ssh-keygen -A

COPY config/sshd_config /etc/ssh/sshd_config
COPY config/nginx.conf /etc/sandpod-config/nginx.conf
COPY config/supervisord.conf /etc/supervisord.conf
COPY config/php-fpm/ /etc/sandpod/php-fpm/
COPY config/default-index.html /srv/customer/public_html/index.html
COPY scripts/runtime-reload /usr/local/bin/sandpod-runtime-reload
COPY scripts/check-runtime-mounts /usr/local/bin/sandpod-check-runtime-mounts

RUN supervisor_password="$(openssl rand -hex 32)" \
    && sed -i "s/__SUPERVISOR_PASSWORD__/${supervisor_password}/g" /etc/supervisord.conf \
    && unset supervisor_password \
    && chmod 0600 /etc/supervisord.conf \
    && chmod 0755 /usr/local/bin/sandpod-runtime-reload \
    && chmod 0755 /usr/local/bin/sandpod-check-runtime-mounts \
    && ln -s /opt/remi/php82/root/usr/bin/php /usr/local/bin/php82 \
    && ln -s /opt/remi/php83/root/usr/bin/php /usr/local/bin/php83 \
    && ln -s /opt/remi/php84/root/usr/bin/php /usr/local/bin/php84 \
    && ln -s /opt/remi/php85/root/usr/bin/php /usr/local/bin/php85 \
    && ln -s /opt/remi/php86/root/usr/bin/php /usr/local/bin/php86 \
    && ln -s /usr/local/bin/php83 /usr/local/bin/php \
    # Shared Node/Python: /usr/local/bin names resolve to the read-only
    # host trees when mounted; when the mount is absent the dangling link
    # is skipped by PATH lookup and the image RPM
    # binaries in /usr/bin take over (fallback, see control-panel Spec v3).
    && ln -s /opt/sandpod/node/default/bin/node /usr/local/bin/node \
    && ln -s /opt/sandpod/node/22/bin/node /usr/local/bin/node-22 \
    && ln -s /opt/sandpod/node/24/bin/node /usr/local/bin/node-24 \
    && ln -s /opt/sandpod/node/26/bin/node /usr/local/bin/node-26 \
    && ln -s /opt/sandpod/node/default/bin/npm /usr/local/bin/npm \
    && ln -s /opt/sandpod/node/22/bin/npm /usr/local/bin/npm-22 \
    && ln -s /opt/sandpod/node/24/bin/npm /usr/local/bin/npm-24 \
    && ln -s /opt/sandpod/node/26/bin/npm /usr/local/bin/npm-26 \
    && ln -s /opt/sandpod/python/default/bin/python3 /usr/local/bin/python3 \
    && ln -s /opt/sandpod/python/3.12/bin/python3.12 /usr/local/bin/python3.12 \
    && ln -s /opt/sandpod/python/3.13/bin/python3.13 /usr/local/bin/python3.13 \
    && ln -s /opt/sandpod/python/3.14/bin/python3.14 /usr/local/bin/python3.14 \
    && ln -sfn /etc/sandpod-config/nginx.conf /etc/nginx/nginx.conf \
    && nginx -t \
    && /usr/sbin/sshd -t

EXPOSE 80 22
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisord.conf"]
