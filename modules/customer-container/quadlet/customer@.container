[Unit]
Description=Rootless customer container %i
After=network-online.target

[Container]
Image=localhost/sandpod/customer-runtime:pilot
ContainerName=customer-%i
Volume=%h/data:/srv/customer:Z
Volume=%h/config:/etc/sandpod-config:ro,Z
Volume=/opt/remi:/opt/remi:ro
Volume=/etc/opt/remi:/etc/opt/remi:ro
Volume=/usr/lib64/libonig.so.105:/usr/lib64/libonig.so.105:ro
UserNS=keep-id:uid=1000,gid=1000
User=0:0
Memory=1g
PidsLimit=512

[Service]
Restart=always
TimeoutStartSec=900
CPUQuota=100%

[Install]
WantedBy=default.target
