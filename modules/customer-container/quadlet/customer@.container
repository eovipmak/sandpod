[Unit]
Description=Rootless customer container %i
After=network-online.target

[Container]
Image=localhost/sandpod/customer-runtime:node-shared
ContainerName=customer-%i
Volume=%h/data:/srv/customer:Z
Volume=%h/config:/etc/sandpod-config:ro,Z
Volume=/opt/remi:/opt/remi:ro
Volume=/etc/opt/remi:/etc/opt/remi:ro
Volume=/usr/lib64/libonig.so.105:/usr/lib64/libonig.so.105:ro
# Shared Node.js runtimes (host-managed, see shared-runtimes module).
# Mounted read-only; when absent the image nodejs RPMs are the fallback.
Volume=/opt/sandpod/node:/opt/sandpod/node:ro
# Shared Python prefixes (host-managed standalone builds, same module).
# Mounted read-only; when absent the image python RPMs are the fallback.
Volume=/opt/sandpod/python:/opt/sandpod/python:ro
UserNS=keep-id:uid=1000,gid=1000
User=0:0
# Hard caps: one customer per container. A busy customer is throttled (CPU/IO)
# or OOM-killed inside its own cgroup and never starves neighbours.
# Podman-level caps (visible inside the container, enforced even if systemd
# delegation is unavailable on the host):
Memory=1g
PidsLimit=512
# --memory-swap=<memory> disables container swap. --cpus mirrors [Service]
# CPUQuota below. IO weight is applied by systemd (IOWeight=100); podman's
# --blkio-weight is omitted because the rootless user slice does not always
# delegate the cgroup v2 io controller (crun then fails to open io.weight).
PodmanArgs=--memory-swap=1g --cpus=1.0

[Service]
Restart=always
TimeoutStartSec=900
# Systemd-level caps (cover the whole service cgroup including conmon/podman
# overhead, so runtime overhead cannot escape the cap either):
# 100% = 1 CPU hard cap; CPUWeight/IOWeight give equal fair shares.
CPUQuota=100%
CPUWeight=100
# High = start reclaim pressure at 90% of Max; Max = hard OOM-kill line.
# SwapMax=0 disables swap for the whole service. TasksMax caps the service
# (payload 512 + runtime overhead headroom); the container payload itself is
# capped by PidsLimit above.
MemoryHigh=900M
MemoryMax=1G
MemorySwapMax=0
TasksMax=1024
IOWeight=100

[Install]
WantedBy=default.target
