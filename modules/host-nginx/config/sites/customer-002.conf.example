# Per-customer site proxies (one file per customer instance).
# Generated by ../host-nginx/scripts/generate-site-conf.sh - do not hand-edit.
# Source: /etc/sandpod/sites.tsv (domain -> 127.0.0.1:web-port).
# Reload with: scripts/reload-host-nginx.sh

# instance 002 example (ports from registry):
# domains: example002.test (add more server_name entries per site)
upstream sandpod_customer_002 {
    server 127.0.0.1:18002 max_fails=2 fail_timeout=10s;
    keepalive 16;
}

server {
    listen 80;
    server_name example002.test www.example002.test;

    location / {
        proxy_pass http://sandpod_customer_002;
        proxy_http_version 1.1;
        # Preserve original Host: the customer container maps Host -> site_root / php backend.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    access_log /var/log/nginx/sandpod-002-access.log;
    error_log /var/log/nginx/sandpod-002-error.log warn;
}
