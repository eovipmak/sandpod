# Regenerate host-nginx customer configs when the fleet registries change,
# then reload nginx. Triggered by the .path unit below (no polling).
[Unit]
Description=SandPod regen + reload host nginx (registry changed)
After=nginx.service

[Service]
Type=oneshot
User=root
ExecStart=/bin/sh -c '/opt/sandpod/repo/modules/sandpodctl/sandpodctl generate-site-conf && /opt/sandpod/repo/modules/sandpodctl/sandpodctl reload-host-nginx'
